+$history = wp_cache_get( $cache_key, 'flamingo' );
+
+if ( false === $history ) {
+    // Build history array
+    // ...
+
+    wp_cache_set( $cache_key, $history, 'flamingo', HOUR_IN_SECONDS );
+}
+```
